# StockSense — environment variable placeholders.
# Copy this file to `.env` and fill in real values from your Shopify Partner
# Dashboard before running `shopify app dev`. No real credentials are needed
# to run tests, lint, or the production build.

SHOPIFY_API_KEY=replace-with-your-api-key
SHOPIFY_API_SECRET=replace-with-your-api-secret
SCOPES=read_inventory,read_products,read_orders,read_locations,write_inventory,read_purchase_orders
SHOPIFY_APP_URL=https://your-tunnel-url.example.com