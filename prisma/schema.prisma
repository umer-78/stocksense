// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  // Postgres (Supabase free tier) — persistent across Render free-tier
  // restarts/redeploys. Use the Supabase *session* pooler URL (port 5432,
  // IPv4) with ?schema=stocksense. See .env.example and DEPLOY.md.
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Per-shop forecasting preferences (defaults used by the dashboard and detail pages).
model ShopSettings {
  shop              String   @id
  defaultLeadTime   Int      @default(14)
  safetyStockPct    Float    @default(0.2)
  targetDays        Int      @default(30)
  lookbackDays      Int      @default(60)
  locationId        String?
  /// "percent" (share of lead-time demand) or "service" (sized from forecast error).
  safetyStockMethod String   @default("percent")
  /// Target chance of not running out during the lead time, for the "service" method.
  serviceLevel      Float    @default(0.95)
  updatedAt         DateTime @updatedAt
}

/// Per-variant overrides of the shop defaults (null = use the default).
model VariantSettings {
  shop           String
  variantId      String
  leadTime       Int?
  safetyStockPct Float?
  targetDays     Int?
  /// Where the values came from: "manual" or "stocky".
  source         String   @default("manual")
  updatedAt      DateTime @updatedAt

  @@id([shop, variantId])
}

/// Inventory + sales snapshot per shop, built from Shopify bulk operations.
/// `data` is the last complete snapshot (gzipped JSON) and stays readable while
/// a refresh runs; `status`/`stage`/`bulkOperationId` track the refresh.
model ShopSnapshot {
  shop            String    @id
  /// "idle" | "running" | "error"
  status          String    @default("idle")
  /// "variants" | "orders" while running
  stage           String?
  bulkOperationId String?
  /// Gzipped variants JSON held between the variants and orders stages.
  pendingVariants Bytes?
  data            Bytes?
  lookbackDays    Int       @default(60)
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Best-effort Stocky CSV imports (variants / PO history). `data` holds the parsed rows as JSON.
model StockyImport {
  id        Int      @id @default(autoincrement())
  shop      String
  fileName  String
  rowCount  Int
  data      String
  createdAt DateTime @default(now())
}

/// Log of GDPR compliance webhooks received (customers/data_request, customers/redact, shop/redact).
model PrivacyEvent {
  id        Int      @id @default(autoincrement())
  shop      String
  topic     String
  payload   String
  createdAt DateTime @default(now())
}

/// Suppliers. Products whose Shopify vendor matches `vendor` use `leadTimeDays`
/// unless the variant has its own lead time.
model Supplier {
  id             Int             @id @default(autoincrement())
  shop           String
  name           String
  vendor         String?
  email          String?
  leadTimeDays   Int?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([shop])
}

/// Purchase orders saved from the builder. status: draft | sent | partial | received | cancelled.
/// Unreceived units on sent/partial orders count as stock on the way.
model PurchaseOrder {
  id         Int                 @id @default(autoincrement())
  shop       String
  /// Per-shop sequence shown as PO-0001.
  number     Int
  supplierId Int?
  supplier   Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status     String              @default("draft")
  note       String?
  createdAt  DateTime            @default(now())
  sentAt     DateTime?
  closedAt   DateTime?
  updatedAt  DateTime            @updatedAt
  lines      PurchaseOrderLine[]

  @@unique([shop, number])
  @@index([shop, status])
}

model PurchaseOrderLine {
  id          Int           @id @default(autoincrement())
  poId        Int
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  variantId   String
  sku         String
  title       String
  qty         Int
  receivedQty Int           @default(0)
  unitCost    Float?

  @@index([poId])
}

/// Low-stock alerts raised from inventory webhooks (also sent to Shopify Flow).
model StockAlert {
  id                Int      @id @default(autoincrement())
  shop              String
  variantId         String
  productTitle      String
  variantTitle      String
  sku               String
  available         Int
  daysToStockout    Float?
  suggestedOrderQty Int
  flowSent          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([shop, variantId, createdAt])
}

/// The plan last seen for a shop, for webhooks and the AI endpoint (no billing context there).
model ShopPlan {
  shop      String   @id
  plan      String   @default("free")
  updatedAt DateTime @updatedAt
}

/// AI-assistant (MCP) API key. Only the SHA-256 hash is stored.
model ApiKey {
  shop       String    @id
  keyHash    String    @unique
  hint       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}
